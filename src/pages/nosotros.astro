---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import PageHero from '../components/PageHero.astro';
import { mision, vision, valores } from '../data/site';
---
<BaseLayout title="Nuestra empresa">
  <PageHero title="Nuestra empresa" img="/assets/img/banner-nosotros.webp" />

  <Section theme="limestone">
    <div class="split">
      <img class="fig reveal" src="/assets/img/mision.webp" alt="Nuestra misión" loading="lazy" />
      <div class="reveal" style="--reveal-delay:.08s">
        <h2>Nuestra misión</h2>
        <p class="lead" style="margin-top:1rem">{mision}</p>
      </div>
    </div>
  </Section>

  <Section theme="ink">
    <div class="split">
      <div class="reveal">
        <h2>Nuestra visión</h2>
        <p class="lead" style="margin-top:1rem">{vision}</p>
      </div>
      <img class="fig reveal" style="--reveal-delay:.08s" src="/assets/img/vision.webp" alt="Nuestra visión" loading="lazy" />
    </div>
  </Section>

  <Section theme="amber">
    <div class="section-head section-head--center reveal">
      <h2>Valores que marcan la diferencia</h2>
    </div>
    <ul class="valores">
      {valores.map((v, i) => (
        <li class="reveal" style={`--reveal-delay:${i * 0.06}s`}>{v}</li>
      ))}
    </ul>
  </Section>
</BaseLayout>

<style>
  .fig { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; border-radius: var(--radius-lg); }
  .valores {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 12rem), 1fr));
    margin-top: 2.25rem;
  }
  .valores li {
    padding: 1.4rem 1rem;
    text-align: center;
    font-family: var(--font-display);
    font-weight: 600;
    letter-spacing: .06em;
    text-transform: uppercase;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: #ffffff33;
  }
</style>
