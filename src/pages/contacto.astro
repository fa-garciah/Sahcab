---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import PageHero from '../components/PageHero.astro';
import Photo from '../components/Photo.astro';
import ContactForm from '../components/ContactForm.astro';
import { site, proceso } from '../data/site';

/* Domicilio, teléfono y correo se publicarán cuando el cliente los confirme (segunda fase). */
---
<BaseLayout title="Contacto">
  <PageHero title={site.cta} img="/assets/img/banner-contacto.webp" />

  <Section theme="limestone">
    <div class="section-head section-head--center reveal">
      <h2>Cuéntanos qué necesita tu inmueble</h2>
      <p>Llena el formulario y te contactamos para revisar el alcance del trabajo.</p>
    </div>
    <div class="split split--top" style="margin-top:2.5rem">
      <div class="form-panel reveal"><ContactForm /></div>
      <Photo class="reveal" style="--reveal-delay:.08s" src="/assets/img/contacto-equipo.webp" alt="Equipo revisando planos de un inmueble" />
    </div>
  </Section>

  <Section theme="sand" tight>
    <div class="section-head section-head--center reveal">
      <h2>Qué sigue después de tu solicitud</h2>
    </div>
    <ol class="next">
      {proceso.slice(1).map((p, i) => (
        <li class="reveal" style={`--reveal-delay:${i * 0.06}s`}>
          <h3>{p.title}</h3>
          <p>{p.text}</p>
        </li>
      ))}
    </ol>
  </Section>
</BaseLayout>

<style>
  .form-panel {
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    padding: clamp(1.4rem, 3vw, 2.4rem);
    box-shadow: var(--shadow-sm);
  }
  .next {
    display: grid;
    gap: 2rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 12rem), 1fr));
    margin-top: 2rem;
    text-align: center;
  }
  .next h3 {
    font-size: var(--fs-sm);
    letter-spacing: .12em;
    text-transform: uppercase;
    color: var(--accent-color);
    margin-bottom: .6rem;
  }
  .next p { font-size: var(--fs-sm); }
</style>
