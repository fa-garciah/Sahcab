---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import PageHero from '../components/PageHero.astro';
import { site, casos } from '../data/site';
---
<BaseLayout title="Casos tipo">
  <PageHero title="Casos tipo" img="/assets/img/banner-cascos.webp" />

  <Section theme="limestone">
    <div class="section-head section-head--center reveal">
      <p class="eyebrow">Ejemplos ilustrativos</p>
      <h2>El tipo de trabajo que realizamos</h2>
      <p>Estos casos describen situaciones frecuentes y cómo las atendemos. No corresponden a clientes específicos ni muestran resultados reales.</p>
    </div>

    <div class="grid grid--2" style="margin-top:2.5rem">
      {casos.map((p, i) => (
        <article class="card reveal" style={`--reveal-delay:${i * 0.06}s`}>
          <div class="card__media case__media">
            <img src={p.img} alt={p.alt} loading="lazy" />
            <span class="case__tag">Caso tipo · Imagen ilustrativa</span>
          </div>
          <div class="card__body">
            <h3 class="case__title">{p.title}</h3>
            <p><strong>Situación.</strong> {p.situacion}</p>
            <p><strong>Qué hacemos.</strong> {p.trabajo}</p>
          </div>
        </article>
      ))}
    </div>

    <p class="cta reveal"><a href="/contacto" class="btn btn--primary">{site.cta}</a></p>
  </Section>
</BaseLayout>

<style>
  .eyebrow { justify-content: center; color: var(--jade); }
  .case__media { position: relative; }
  .case__tag {
    position: absolute;
    left: .75rem;
    bottom: .75rem;
    padding: .25em .7em;
    font-size: var(--fs-xs);
    letter-spacing: .04em;
    color: var(--white);
    background: #16181dbf;
    border-radius: 999px;
  }
  .case__title { font-size: var(--fs-h3); }
  .card__body strong { color: var(--ink); font-weight: 600; }
  .cta { margin-top: 2.5rem; text-align: center; }
</style>
