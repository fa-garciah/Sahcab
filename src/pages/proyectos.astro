---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import PageHero from '../components/PageHero.astro';
import { casos } from '../data/site';
---
<BaseLayout title="Proyectos">
  <PageHero title="Casos de éxito" img="/assets/img/banner-cascos.webp" />

  <Section theme="limestone">
    <div class="grid grid--2">
      {casos.map((p, i) => (
        <article class="card reveal" style={`--reveal-delay:${i * 0.06}s`}>
          <div class="card__media"><img src={p.img} alt={p.title} loading="lazy" /></div>
          <div class="card__body">
            <h2 class="case__title">{p.title}</h2>
            <p>{p.text}</p>
          </div>
        </article>
      ))}
    </div>
  </Section>
</BaseLayout>

<style>
  .case__title { font-size: var(--fs-h3); }
</style>
