---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import Projects from '../components/Projects.astro';
import ContactForm from '../components/ContactForm.astro';
import Photo from '../components/Photo.astro';
import { site, intro, services, proceso, mercado } from '../data/site';
---
<BaseLayout overHero>
  {/* Portada */}
  <section class="hero" data-theme="ink">
    <img class="hero__bg" src="/assets/img/hero-obra.webp" alt="" aria-hidden="true" fetchpriority="high" />
    <div class="hero__veil" aria-hidden="true"></div>
    <div class="container hero__inner">
      <p class="eyebrow hero__eyebrow reveal">Mantenimiento integral de inmuebles</p>
      <h1 class="display reveal">Soluciones para mantener tus espacios <span class="hero__accent">operando correctamente</span></h1>
      <div class="hero__actions reveal" style="--reveal-delay:.1s">
        <a href="/contacto" class="btn btn--amber">{site.cta}</a>
        <a href="/servicios" class="btn btn--outline">Ver servicios</a>
      </div>
    </div>
    <div class="greca hero__greca" aria-hidden="true"></div>
  </section>

  {/* Acerca de */}
  <Section theme="limestone">
    <div class="split split--wide-left">
      <div class="reveal">
        <h2>Ejecutamos el mantenimiento, las instalaciones y las adecuaciones que tu inmueble necesita.</h2>
        <p class="lead" style="margin-top:1.1rem">
          Somos una empresa de servicios de mantenimiento integral con altos estándares de calidad,
          sustentados en buenas prácticas y mejora continua. Nuestro compromiso es con la excelencia:
          trabajamos superando las expectativas y estableciéndonos como un referente confiable.
        </p>
        <p style="margin-top:1.6rem"><a href="/nosotros" class="btn btn--primary">Conócenos</a></p>
      </div>
      <Photo class="reveal" style="--reveal-delay:.08s" src="/assets/img/nosotros-ingeniero.webp" alt="Supervisor con casco de seguridad" />
    </div>
  </Section>

  {/* Franja */}
  <section class="band" data-theme="amber">
    <img class="band__bg" src="/assets/img/banner-cascos.webp" alt="" aria-hidden="true" loading="lazy" />
    <div class="band__veil" aria-hidden="true"></div>
    <div class="container band__inner">
      <h2 class="reveal">Mantenimiento, adecuaciones, limpieza especializada y servicios técnicos</h2>
    </div>
  </section>

  {/* Nuestros servicios */}
  <Section theme="limestone">
    <div class="section-head section-head--center reveal">
      <h2>Nuestros servicios</h2>
      <p class="intro-title">{intro.titulo}</p>
      <p>{intro.texto}</p>
    </div>

    <div class="grid grid--4" style="margin-top:2.75rem">
      {services.map((s, i) => (
        <a href={`/servicios#${s.slug}`} class="card reveal" style={`--reveal-delay:${i * 0.06}s`}>
          <div class="card__media"><img src={s.img} alt={s.alt} loading="lazy" /></div>
          <div class="card__body">
            <span class="card__n">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="card__title">{s.title}</h3>
            <p>{s.text}</p>
          </div>
        </a>
      ))}
    </div>
    <p class="note reveal">Imágenes ilustrativas.</p>

    <div class="services-foot reveal">
      <a href="/contacto" class="btn btn--link">{site.cta} <span class="arrow">→</span></a>
      <a href="/servicios" class="btn btn--primary">Ver alcance de cada servicio</a>
    </div>
  </Section>

  {/* Cómo trabajamos */}
  <Section theme="ink">
    <div class="section-head section-head--center reveal">
      <h2>Cómo atendemos tu solicitud</h2>
      <p>Del primer contacto a la entrega, cada trabajo sigue el mismo orden.</p>
    </div>
    <ol class="steps">
      {proceso.map((p, i) => (
        <li class="reveal" style={`--reveal-delay:${i * 0.06}s`}>
          <span class="steps__n">{String(i + 1).padStart(2, '0')}</span>
          <h3>{p.title}</h3>
          <p>{p.text}</p>
        </li>
      ))}
    </ol>
  </Section>

  {/* Casos tipo */}
  <Section theme="sand">
    <div class="section-head section-head--center reveal">
      <h2>Casos tipo</h2>
      <p>Ejemplos ilustrativos del tipo de trabajo que realizamos. No corresponden a clientes específicos.</p>
    </div>
    <div class="reveal" style="margin-top:2.25rem">
      <Projects />
    </div>
  </Section>

  {/* Mercado */}
  <Section theme="jade" tight>
    <h2 class="mercado__title reveal">Atendemos</h2>
    <ul class="mercado">
      {mercado.map((m, i) => (
        <li class="reveal" style={`--reveal-delay:${i * 0.05}s`}>{m}</li>
      ))}
    </ul>
  </Section>

  {/* Solicita atención */}
  <Section theme="limestone" id="contacto">
    <div class="section-head section-head--center reveal">
      <h2>{site.cta}</h2>
      <p>Cuéntanos qué necesita tu inmueble y te contactamos para revisar el alcance.</p>
    </div>
    <div class="split split--top" style="margin-top:2.5rem">
      <div class="form-panel reveal"><ContactForm /></div>
      <Photo class="reveal" style="--reveal-delay:.08s" src="/assets/img/contacto-equipo.webp" alt="Equipo revisando planos de un inmueble" />
    </div>
  </Section>
</BaseLayout>

<style>
  .hero {
    position: relative;
    display: flex;
    align-items: center;
    min-height: min(84svh, 46rem);
    padding-block: clamp(8rem, 14vw, 10rem) clamp(4rem, 8vw, 6rem);
    background: var(--ink);
    color: var(--white);
    overflow: hidden;
  }
  .hero__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    animation: hero-zoom 20s var(--ease) forwards;
  }
  @keyframes hero-zoom { from { transform: scale(1.05); } to { transform: scale(1); } }
  .hero__veil {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(105deg, #16181def 0%, #16181dc4 45%, #16181d5c 100%),
      linear-gradient(0deg, #16181d94 0%, transparent 40%);
  }
  .hero__inner { position: relative; max-width: 52rem; }
  .hero__accent { color: var(--amber); }
  .hero__eyebrow { color: var(--amber); margin-bottom: 1.1rem; }
  .hero__actions { display: flex; flex-wrap: wrap; gap: .8rem; margin-top: 2.1rem; }
  .hero .btn--outline { color: var(--white); }
  .hero__greca { position: absolute; left: 0; right: 0; bottom: 0; }

  .band {
    position: relative;
    padding-block: clamp(4.5rem, 9vw, 7rem);
    background: var(--amber);
    color: var(--white);
    overflow: hidden;
    text-align: center;
  }
  .band__bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .band__veil { position: absolute; inset: 0; background: color-mix(in srgb, var(--amber-deep) 72%, transparent); }
  .band__inner { position: relative; max-width: 50rem; }

  .intro-title { font-family: var(--font-display); font-weight: 600; font-size: var(--fs-h4); color: var(--fg) !important; }

  .services-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 1rem 2rem;
    margin-top: 2.5rem;
  }

  .card__n { font-family: var(--font-display); font-size: var(--fs-sm); font-weight: 700; color: var(--accent-color); }
  .card__title { font-size: var(--fs-h4); }
  .note { margin-top: .9rem; font-size: var(--fs-xs); color: var(--muted); text-align: center; }

  .steps {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr));
    margin-top: 2.5rem;
  }
  @media (min-width: 760px) { .steps { grid-template-columns: repeat(5, 1fr); } }
  .steps li {
    display: flex;
    flex-direction: column;
    gap: .45rem;
    padding: 1.4rem 1.2rem;
    border: 1px solid var(--line);
    border-top: 3px solid var(--amber);
    border-radius: var(--radius-lg);
    background: #ffffff08;
  }
  .steps__n { font-family: var(--font-display); font-weight: 700; color: var(--amber); }
  .steps h3 { font-size: var(--fs-h4); }
  .steps p { font-size: var(--fs-sm); color: var(--muted); }

  .mercado__title { text-align: center; }
  .mercado {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: .75rem;
    margin-top: 1.75rem;
  }
  .mercado li {
    padding: .7em 1.4em;
    font-family: var(--font-display);
    font-weight: 600;
    letter-spacing: .04em;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: #ffffff14;
  }

  .form-panel {
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    padding: clamp(1.4rem, 2.8vw, 2.1rem);
    box-shadow: var(--shadow-sm);
  }
</style>
