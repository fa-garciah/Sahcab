---
/* Isotipo: pirámide escalonada de sillares con la clave en ámbar. */
interface Props { size?: number; class?: string }
const { size = 34, class: cls } = Astro.props;
---
<span class:list={['logo', cls]} style={`--logo-size:${size}px`}>
  <svg class="logo__mark" viewBox="0 0 40 40" width={size} height={size} aria-hidden="true" focusable="false">
    <rect x="12" y="2" width="16" height="10" rx="1" fill="var(--amber)" />
    <rect x="6" y="15" width="13" height="10" rx="1" fill="currentColor" />
    <rect x="21" y="15" width="13" height="10" rx="1" fill="currentColor" />
    <rect x="0" y="28" width="11.5" height="10" rx="1" fill="currentColor" />
    <rect x="14.25" y="28" width="11.5" height="10" rx="1" fill="currentColor" />
    <rect x="28.5" y="28" width="11.5" height="10" rx="1" fill="currentColor" />
  </svg>
  <span class="logo__word">Sahcab</span>
</span>

<style>
  .logo { display: inline-flex; align-items: center; gap: .55em; }
  .logo__mark { flex: none; }
  .logo__word {
    font-family: var(--font-display);
    font-size: calc(var(--logo-size) * .64);
    font-weight: 700;
    letter-spacing: .03em;
    text-transform: uppercase;
    line-height: 1;
  }
</style>
