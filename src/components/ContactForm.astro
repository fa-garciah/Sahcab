---
import { site, services } from '../data/site';

/* Sin backend: al enviarse abre el cliente de correo con los datos del formulario. */
---
<form class="form" data-contact-form novalidate>
  <fieldset class="field">
    <legend>Nombre</legend>
    <div class="form__row">
      <label class="field">
        <span>Nombre (obligatorio)</span>
        <input type="text" name="fname" autocomplete="given-name" required />
      </label>
      <label class="field">
        <span>Apellido (obligatorio)</span>
        <input type="text" name="lname" autocomplete="family-name" required />
      </label>
    </div>
  </fieldset>

  <label class="field">
    <span>Empresa (obligatorio)</span>
    <input type="text" name="empresa" required />
  </label>

  <label class="field">
    <span>Cargo</span>
    <input type="text" name="cargo" autocomplete="organization-title" />
  </label>

  <label class="field">
    <span>Correo (obligatorio)</span>
    <input type="email" name="correo" autocomplete="email" required />
  </label>

  <label class="check">
    <input type="checkbox" name="newsletter" value="Sí" />
    <span>Regístrate para recibir noticias y actualizaciones</span>
  </label>

  <label class="field">
    <span>Teléfono</span>
    <input type="text" name="telefono" inputmode="numeric" autocomplete="tel-national" />
  </label>

  <label class="field">
    <span>Servicio de interés</span>
    <select name="servicio">
      <option value="" disabled selected>Selecciona una opción</option>
      {services.map((s) => <option value={s.title}>{s.title}</option>)}
    </select>
  </label>

  <input class="honeypot" type="text" name="company-website" tabindex="-1" autocomplete="off" aria-hidden="true" />

  <div>
    <button type="submit" class="btn btn--primary">Enviar</button>
  </div>
  <p class="form__status" data-form-status role="status" aria-live="polite"></p>
</form>

<style>
  .form { display: flex; flex-direction: column; gap: 1rem; }
  .form__row { display: grid; gap: 1rem; }
  @media (min-width: 540px) { .form__row { grid-template-columns: 1fr 1fr; } }

  fieldset { border: 0; padding: 0; margin: 0; }
  legend { font-size: var(--fs-sm); font-weight: 500; margin-bottom: .5rem; padding: 0; }
  .field { display: flex; flex-direction: column; gap: .35rem; }
  .field > span { font-size: var(--fs-sm); color: var(--muted); }

  input[type='text'], input[type='email'], select {
    width: 100%;
    padding: .6rem .7rem;
    font: inherit;
    font-size: var(--fs-sm);
    color: var(--ink);
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }
  input:focus, select:focus { outline: none; border-color: var(--jade); }

  .check { display: flex; align-items: flex-start; gap: .55rem; font-size: var(--fs-sm); color: var(--muted); }
  .check input { width: 16px; height: 16px; margin-top: .2rem; accent-color: var(--jade); flex: none; }

  input.honeypot { position: absolute; left: -9999px; width: 1px; height: 1px; padding: 0; border: 0; opacity: 0; }

  .form__status { font-size: var(--fs-sm); color: var(--jade); }
  .form__status:empty { display: none; }
</style>

<script>
  import { site } from '../data/site';

  document.querySelectorAll<HTMLFormElement>('[data-contact-form]').forEach((form) => {
    const status = form.querySelector<HTMLElement>('[data-form-status]');
    form.addEventListener('submit', (event) => {
      event.preventDefault();
      if (!form.reportValidity()) return;

      const data = new FormData(form);
      if (data.get('company-website')) return; // honeypot

      const body = [
        `Nombre: ${data.get('fname') ?? ''} ${data.get('lname') ?? ''}`,
        `Empresa: ${data.get('empresa') ?? ''}`,
        `Cargo: ${data.get('cargo') ?? ''}`,
        `Correo: ${data.get('correo') ?? ''}`,
        `Teléfono: ${data.get('telefono') ?? ''}`,
        `Servicio de interés: ${data.get('servicio') ?? ''}`,
        `Noticias y actualizaciones: ${data.get('newsletter') ? 'Sí' : 'No'}`,
      ].join('\n');

      window.location.href = `mailto:${site.email}?subject=${encodeURIComponent('Contacto desde el sitio web')}&body=${encodeURIComponent(body)}`;
      if (status) status.textContent = 'Abriendo tu cliente de correo…';
    });
  });
</script>
